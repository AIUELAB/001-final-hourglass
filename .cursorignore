# Binaries and caches
bin/*.tar.gz
**/.DS_Store
**/.cache/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/__pycache__/
coverage/
.build/
build/
dist/

# Python envs - CRITICAL: Must exclude to prevent 20K+ errors
venv/
.venv/
**/venv/
**/.venv/
env/
ENV/

# iOS Build Artifacts - CRITICAL: Must exclude to prevent 60K+ errors
ios-apps/final-hourglass/DerivedData/
**/DerivedData/
*.xcodeproj/
*.xcworkspace/
*.app/
*.ipa/
*.dSYM/

# Node
node_modules/
**/node_modules/
raycast-n8n-extension/node_modules/

# Local n8n data
.n8n/

# IDE/Editor
.vscode/
.idea/
.cursor/

# Logs and temp
**/*.log
**/*.tmp
**/*.swp
**/*.swo

# Generated docs/site
site/

# Large data files and backups
*.csv
*.json
backup_*/
checkpoints*/
archive*/
deletion_backups/
emergency_backups/
cache/

# 例外: マスターCSVは品質ゲート/修正作業で参照するため許可する
# - それ以外の大量CSVは引き続き除外（LSP/インデクサ過負荷防止）
!preserved/data/MASTER_EPISODES_CURRENT.csv

# iOS specific
ios-apps/
# 例外: Swift 6 並行性修正のため UI テストファイルのみツールで読み書き可能にする
!ios-apps/final-hourglass/
!ios-apps/final-hourglass/FinalHourglassUITests/
!ios-apps/final-hourglass/FinalHourglassUITests/SnapshotUITests.swift
Pods/
Carthage/
fastlane/
