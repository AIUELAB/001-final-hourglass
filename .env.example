# 知名度評価システム - API設定テンプレート
# このファイルを.envとしてコピーして、実際のAPIキーを設定してください

# Google Search (SerpAPI)
# https://serpapi.com/ で取得
SERPAPI_API_KEY=your_serpapi_key_here

# YouTube Data API v3
# https://console.cloud.google.com/ で取得
YOUTUBE_API_KEY=your_youtube_api_key_here

# Twitter API v2
# https://developer.twitter.com/ で取得
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# News API
# https://newsapi.org/ で取得
NEWS_API_KEY=your_news_api_key_here

# Brave Search API
# https://brave.com/search/api/ で取得
BRAVE_API_KEY=your_brave_api_key_here

# Optional: Redis Cache (将来の拡張用)
REDIS_URL=redis://localhost:6379/0

# Optional: PostgreSQL Database (将来の拡張用)
DATABASE_URL=postgresql://user:password@localhost:5432/recognition_db

# System Settings
LOG_LEVEL=INFO
CACHE_TTL_DAYS=7
MAX_WORKERS=5
BATCH_SIZE=10
