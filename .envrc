# ============================================================
# direnv設定 - 001-final-hourglass プロジェクト
# ============================================================
# このファイルはディレクトリに入った際に自動的に読み込まれます
# direnvをインストールしている場合のみ有効
# ============================================================

# プロジェクトディレクトリに移動した際のメッセージ
echo "📂 Entering: 001-final-hourglass プロジェクト"

# ============================================================
# Claude Code: npm版の診断/移行案内の抑制
# ============================================================
# なぜ: npm版Claude Codeが毎回「native installerへ移行してください」と通知を出すため。
#      このプロジェクトではノイズになりやすいので抑制します。
# 備考: 必要になったら値を削除/0に戻してください。
export DISABLE_INSTALLATION_CHECKS=1

# ============================================================
# Claude Code: 自動アップデート無効化
# ============================================================
# なぜ: 自動更新で `cli.js` の実行権限が崩れ、`permission denied: claude` が再発するのを防ぐため。
export DISABLE_AUTOUPDATER=1

# 仮想環境の自動アクティベート
if [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
fi

# システムステータスの自動表示
if [ -f ".session/auto_startup_display.sh" ]; then
    bash .session/auto_startup_display.sh
fi
