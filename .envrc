#!/bin/bash
# ============================================================
# 🚀 AI協調分析システム自動起動フック（direnv版）
# ============================================================
# プロジェクトディレクトリ入場時に自動実行
# Claude Code、Cursor、通常のターミナルすべてで動作
#
# セットアップ:
#   brew install direnv
#   echo 'eval "$(direnv hook bash)"' >> ~/.bashrc
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc
#   direnv allow .
# ============================================================

# プロジェクトルート設定
export PROJECT_ROOT="$(pwd)"
export PYTHONPATH="${PROJECT_ROOT}/src:${PYTHONPATH}"

# ログファイル
STARTUP_LOG="${PROJECT_ROOT}/.direnv_startup.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] 🚀 direnv起動フック開始" >> "$STARTUP_LOG"

# ============================================================
# 🔍 既存プロセスチェック（重複起動防止）
# ============================================================
check_process_running() {
    local process_name=$1
    pgrep -f "$process_name" > /dev/null 2>&1
}

# ============================================================
# 🎯 Serena MCPサーバー起動
# ============================================================
if ! check_process_running "start_serena_server.py"; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 🎯 Serena起動開始" >> "$STARTUP_LOG"

    if [ -f "${PROJECT_ROOT}/scripts/start_serena_server.py" ]; then
        (
            cd "$PROJECT_ROOT" || exit 1
            python3 scripts/start_serena_server.py > /dev/null 2>&1 &
            echo $! > .serena.pid
        )
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ✅ Serena起動成功" >> "$STARTUP_LOG"
    else
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ⚠️ start_serena_server.py not found" >> "$STARTUP_LOG"
    fi
else
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ℹ️ Serena既に起動中" >> "$STARTUP_LOG"
fi

# ============================================================
# 🤖 Codex MCPサーバー起動
# ============================================================
if ! check_process_running "start_codex_server.py"; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 🤖 Codex起動開始" >> "$STARTUP_LOG"

    if [ -f "${PROJECT_ROOT}/scripts/start_codex_server.py" ]; then
        (
            cd "$PROJECT_ROOT" || exit 1
            python3 scripts/start_codex_server.py > /dev/null 2>&1 &
            echo $! > .codex.pid
        )
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ✅ Codex起動成功" >> "$STARTUP_LOG"
    else
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ⚠️ start_codex_server.py not found" >> "$STARTUP_LOG"
    fi
else
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ℹ️ Codex既に起動中" >> "$STARTUP_LOG"
fi

# ============================================================
# 📊 自動同期システム起動
# ============================================================
if [ -f "${PROJECT_ROOT}/auto_startup_sync.py" ]; then
    if ! check_process_running "auto_startup_sync.py"; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] 📊 自動同期開始" >> "$STARTUP_LOG"
        (
            cd "$PROJECT_ROOT" || exit 1
            python3 auto_startup_sync.py > /dev/null 2>&1 &
        )
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ✅ 自動同期起動" >> "$STARTUP_LOG"
    fi
fi

# ============================================================
# 🎨 起動メッセージ（初回のみ）
# ============================================================
if [ ! -f "${PROJECT_ROOT}/.direnv_initialized" ]; then
    cat << 'EOF'

╔═══════════════════════════════════════════════════════╗
║   🚀 AI協調分析システム 自動起動完了                ║
║                                                       ║
║   ✅ Serena MCP Server                               ║
║   ✅ Codex MCP Server                                ║
║   ✅ 自動同期システム                                ║
║                                                       ║
║   📊 ダッシュボード:                                 ║
║      http://127.0.0.1:24282/dashboard/index.html     ║
╚═══════════════════════════════════════════════════════╝

EOF
    touch "${PROJECT_ROOT}/.direnv_initialized"
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] 🎉 direnv起動フック完了" >> "$STARTUP_LOG"

# 環境変数エクスポート
export AI_COLLABORATION_ENABLED=true
export SERENA_ENABLED=true
export CODEX_ENABLED=true
