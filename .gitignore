.rca_kaizen/*_FINAL_*.md

# API関連
.api_credits.json
.retry_statistics.json

# 一時分析ファイル
.phase*_analysis.json
.phase*_checkpoint.json
.phase*_result.json
*_temp_*.json

# 大量の一時CSVファイル
batch_*.csv
test_*.csv
temp_*.csv
debug_*.csv
sample_*.csv

# データベースバックアップ
DATABASE_*.csv
*_database_*.csv

# Ultra Think関連の大量ファイル
ultra_think_improvements/
ultra_think_*.csv

# 古いエピソードファイル
#episodes_*.csv
all_episodes_*.csv
all_episodes_*.csv.backup_*
*_validated_*.csv
*_fixed_*.csv
*_COMPLETE_*.csv
*_PHASE*_*.csv

# N8Nワークフロー
.n8n/

# 監査レポート
audit_reports/

# 変更履歴
.changes/

