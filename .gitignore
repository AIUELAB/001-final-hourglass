# ========================================
# AIUELAB統一 .gitignore テンプレート
# ========================================
# Purpose: LSP/インデクサの過負荷を防ぐための除外規則
# Version: 2.0.0
# Last Updated: 2025-11-04
# ========================================

# ========================================
# Node.js / npm
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ========================================
# Python
# ========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
ENV/
env/
.venv

# Python キャッシュ（追加）
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ========================================
# IDEs / Editors
# ========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# ========================================
# Build Outputs
# ========================================
dist/
build/
out/
*.log
*.pid
*.seed
*.pid.lock

# ========================================
# Testing
# ========================================
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
coverage/
*.cover
.hypothesis/

# ========================================
# Environment Variables
# ========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.mcp
.env.mysql

# ========================================
# Temporary Files
# ========================================
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/

# ========================================
# Database Files
# ========================================
*.db
*.sqlite
*.sqlite3
*.db-journal

# ========================================
# MacOS
# ========================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ========================================
# Crash Resilience System (Project-Specific)
# ========================================
.sre/telemetry/metrics/
.sre/telemetry/logs/
.aiuelab/snapshots/
.aiuelab/state/

# ========================================
# MCP Servers
# ========================================
*.mcp.log

# ========================================
# Documentation (Generated)
# ========================================
site/
docs/_build/

# ========================================
# Large Binary Files
# ========================================
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.tar.gz
*.rar

# ========================================
# AIUELAB プロジェクト固有の除外（重要）
# ========================================

# バックアップCSVファイル
*.backup_*.csv
*_backup_*.csv
*.backup.csv
*_BACKUP_*.csv
*_OLD.csv
MASTER_EPISODES*.backup_*.csv
MASTER_EPISODES*_OLD.csv

# チェックポイントファイル
*_checkpoint_*.csv
*_CHECKPOINT_*.csv

# チェックポイントディレクトリ
checkpoints/
checkpoints_final/
checkpoints_massive/
checkpoints_ultimate/
backup/
backups/
.rollback_snapshots/

# ログとキャッシュ
logs/
.cache/
.tech_cache/
.continuous_improvement/
.profiling/
.quality_metrics/

# セッション管理（一部）
