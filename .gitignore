# Gitignoreバックアップ
.gitignore.backup.*
.gitignore_backup_*

# ドキュメントバックアップ
claudedocs/*_REPORT_2025*.md
claudedocs/*_report_2025*.md
claudedocs/*_LOG_2025*.md
claudedocs/PHASE*_COMPLETE_*.md
claudedocs/*_COMPLETION_2025*.md
claudedocs/MYSQL_PHASE*.md
claudedocs/*_20251*.md

# カバレッジレポート
.coverage*.json
htmlcov/

# 削除レポート
DELETED_*.csv
DELETION_*.csv
*_CANDIDATES_*.csv

# アーカイブディレクトリ（古いスクリプト）
# 注: archive/README.mdは追跡する
archive/batch_scripts/
archive/analysis_scripts/
archive/old_scripts/
archive/deprecated/

# ===========================================
# 除外しないファイル（重要なファイルを保護）
# ===========================================
# 以下のファイルは必ず追跡する
!MASTER_EPISODES_v1.0.0_20251031_japanese_fixed.csv
!requirements*.txt
!README*.md
!CHANGELOG.md
!CLAUDE.md
!.session/STATUS.md
!.session/SESSION_LOG.md
!.session/SYSTEM_AUTO_GUIDE.md

# MASTER_EPISODESの他のバージョンは除外
MASTER_EPISODES*.csv
MASTER_EPISODES*.backup*
!MASTER_EPISODES_v1.0.0_20251031_japanese_fixed.csv
.session/SESSION_LOG.md
episode_database_dashboard_v2.html
.pids/

