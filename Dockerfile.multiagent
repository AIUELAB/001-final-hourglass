# Dockerfile for Multi-Agent Quality System
# Optimized for asyncio and ML workloads
# Phase 4 - Production Deployment

# Stage 1: Python Builder
FROM python:3.11-slim AS python-builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    libssl-dev \
    libffi-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create requirements for multiagent system
COPY requirements.txt .
RUN echo "aiohttp>=3.8.0" >> requirements.txt && \
    echo "scikit-learn>=1.3.0" >> requirements.txt && \
    echo "numpy>=1.24.0" >> requirements.txt && \
    echo "pandas>=2.0.0" >> requirements.txt && \
    echo "asyncio-mqtt>=0.16.0" >> requirements.txt && \
    echo "prometheus-client>=0.17.0" >> requirements.txt && \
    echo "redis>=5.0.0" >> requirements.txt && \
    echo "psycopg2-binary>=2.9.0" >> requirements.txt

# Install Python dependencies with caching
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Runtime Image
FROM python:3.11-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -s /bin/bash appuser && \
    mkdir -p /var/log/supervisor && \
    chown -R appuser:appuser /var/log/supervisor

WORKDIR /app

# Copy Python dependencies from builder
COPY --from=python-builder --chown=appuser:appuser /root/.local /home/appuser/.local

# Copy application code
COPY --chown=appuser:appuser . .

# Create necessary directories
RUN mkdir -p \
    /app/logs \
    /app/data \
    /app/models \
    /app/.cache \
    /app/monitoring && \
    chown -R appuser:appuser /app

# Environment variables
ENV PYTHONPATH=/app:$PYTHONPATH
ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV ASYNCIO_EVENT_LOOP=uvloop
ENV ML_MODEL_PATH=/app/models
ENV CACHE_DIR=/app/.cache
ENV LOG_LEVEL=INFO

# Copy supervisor configuration
COPY --chown=appuser:appuser <<EOF /etc/supervisor/conf.d/multiagent.conf
[supervisord]
nodaemon=true
user=appuser

[program:orchestrator]
command=python multi_agent_orchestrator.py
directory=/app
autostart=true
autorestart=true
stdout_logfile=/app/logs/orchestrator.log
stderr_logfile=/app/logs/orchestrator-error.log

[program:codex-server]
command=python codex_mcp_server.py
directory=/app
autostart=true
autorestart=true
stdout_logfile=/app/logs/codex.log
stderr_logfile=/app/logs/codex-error.log

[program:quality-system]
command=python autonomous_quality_system.py
directory=/app
autostart=true
autorestart=true
stdout_logfile=/app/logs/quality.log
stderr_logfile=/app/logs/quality-error.log
EOF

# Health check script
COPY --chown=appuser:appuser <<'EOF' /app/healthcheck.py
#!/usr/bin/env python3
import sys
import asyncio
import aiohttp

async def check_health():
    try:
        # Check Codex server
        async with aiohttp.ClientSession() as session:
            async with session.get('http://localhost:8001/health', timeout=5) as resp:
                if resp.status != 200:
                    return False

        # Check orchestrator (would need endpoint)
        # Check quality system (would need endpoint)

        return True
    except Exception as e:
        print(f"Health check failed: {e}", file=sys.stderr)
        return False

if __name__ == "__main__":
    result = asyncio.run(check_health())
    sys.exit(0 if result else 1)
EOF

RUN chmod +x /app/healthcheck.py

# Switch to non-root user
USER appuser

# Expose ports
EXPOSE 8001 8002 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python /app/healthcheck.py

# Default command using supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/multiagent.conf"]

# Labels
LABEL maintainer="Quality System Team"
LABEL version="4.0.0"
LABEL description="Multi-Agent Quality Orchestration System"
LABEL phase="4"