# Backend Environment Variables Example
# 本番環境用の環境変数テンプレート

# Environment (development, production, staging)
ENVIRONMENT=production

# Database
DATABASE_URL=sqlite:///./characters.db
# 本番環境ではPostgreSQLを推奨:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings
# フロントエンドのデプロイURL（Vercel/Netlify）を指定
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,https://your-app.vercel.app,https://your-app.netlify.app

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Logging
LOG_LEVEL=INFO

# CSV Data Path
CSV_DATA_PATH=./data/final_characters.csv

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auto-Sync Settings
# CSV変更時にSupabaseへ自動同期する機能（デフォルト無効）
ENABLE_SUPABASE_CSV_AUTOSYNC=0
SUPABASE_AUTOSYNC_BATCH_SIZE=500
SUPABASE_AUTOSYNC_THROTTLE_SECONDS=60
SUPABASE_AUTOSYNC_STABLE_WAIT_SECONDS=10
SUPABASE_AUTOSYNC_STABLE_WINDOW_SECONDS=1
