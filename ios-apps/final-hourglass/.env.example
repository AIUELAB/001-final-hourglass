# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=final-hourglass-app
FIREBASE_AUTH_DOMAIN=final-hourglass-app.firebaseapp.com
FIREBASE_STORAGE_BUCKET=final-hourglass-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Apple Developer Account
APPLE_TEAM_ID=N4UHXSGNLU
APPLE_BUNDLE_ID=com.AIUELAB.FinalHourglass

# App Store Connect
APP_STORE_CONNECT_API_KEY_ID=your_key_id
APP_STORE_CONNECT_API_ISSUER_ID=your_issuer_id
APP_STORE_CONNECT_API_KEY_PATH=./private_keys/AuthKey.p8

# TestFlight
TESTFLIGHT_PUBLIC_LINK=https://testflight.apple.com/join/your_link

# Environment
ENVIRONMENT=development
DEBUG_MODE=true
