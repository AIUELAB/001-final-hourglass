// Release Configuration for FinalHourglass
// Note: Dependencies are managed via Swift Package Manager (SPM)

// dSYM File Generation Settings for Firebase Crash Reporting

// Generate dSYM files for all builds
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym

// Ensure dSYM files accompany the product
DWARF_DSYM_FILE_SHOULD_ACCOMPANY_PRODUCT = YES

// Don't strip debug symbols during copy
COPY_PHASE_STRIP = NO

// Don't strip installed product (for better crash reports)
STRIP_INSTALLED_PRODUCT = NO

// Don't strip Swift symbols
STRIP_SWIFT_SYMBOLS = NO

// Keep symbols for better debugging
DEPLOYMENT_POSTPROCESSING = NO

// Validate product settings
VALIDATE_PRODUCT = YES

// Archive用: アプリをProducts/Applications/にインストールする（TN3110対応）
SKIP_INSTALL = NO
INSTALL_PATH = $(LOCAL_APPS_DIR)

// Metal shader debug info (dSYM品質向上)
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE

// Bitcode is deprecated by Apple (Xcode 14+)
ENABLE_BITCODE = NO

// Swift optimization level
SWIFT_OPTIMIZATION_LEVEL = -O

// Clang optimization level
GCC_OPTIMIZATION_LEVEL = s

// Enable testability for release builds
ENABLE_TESTABILITY = NO

// Swift compilation mode
SWIFT_COMPILATION_MODE = wholemodule

// AppIntents自動リンクを無効化（AppIntentsを使用しない場合の警告抑制）
OTHER_SWIFT_FLAGS = $(inherited) -Xfrontend -disable-autolink-framework -Xfrontend AppIntents

