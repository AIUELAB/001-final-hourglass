# スクリーンショット生成設定

# デバイス（App Store Connect 必須サイズ）
devices([
  "iPhone 16 Pro Max",   # 6.7インチ
  "iPhone 16 Pro",       # 6.1インチ
  "iPad Pro 13-inch (M4)" # 13インチ（iPhone互換モード）
])

# 言語
languages(["ja"])

# テストスキーム
scheme("FinalHourglass")

# ワークスペース
workspace("./FinalHourglass.xcworkspace")

# iOS バージョン
ios_version("18.6")

# DerivedData（既存ビルドを再利用）
derived_data_path("./DerivedData/FinalHourglass")

# 出力先
output_directory("./fastlane/screenshots")

# スクリーンショット取得前にステータスバーを統一
override_status_bar(true)

# クリーンアップ
clear_previous_screenshots(true)

# 並列実行
concurrent_simulators(true)
