{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena-mcp-server",
        "--project",
        "/Users/admin/Documents/AIUELAB/001-final-hourglass"
      ],
      "env": {}
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/admin/Documents"
      ],
      "env": {}
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {}
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context7/mcp-server"
      ],
      "env": {}
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "ide": {
      "command": "npx",
      "args": [
        "-y",
        "@win32user/mcp-ide"
      ],
      "env": {}
    },
    "firecrawl": {
      "command": "uvx",
      "args": [
        "firecrawl-mcp-server"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {}
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "env": {}
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/dbname"
      ],
      "env": {}
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      },
      "disabled": true
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_API_URL": "https://gitlab.com/api/v4"
      },
      "disabled": true
    },
    "google-maps": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-google-maps"
      ],
      "env": {
        "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
      },
      "disabled": true
    },
    "aws": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-aws"
      ],
      "env": {
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "AWS_REGION": "${AWS_REGION}"
      },
      "disabled": true
    },
    "gcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      },
      "disabled": true
    },
    "azure": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-azure"
      ],
      "env": {
        "AZURE_SUBSCRIPTION_ID": "${AZURE_SUBSCRIPTION_ID}",
        "AZURE_CLIENT_ID": "${AZURE_CLIENT_ID}",
        "AZURE_CLIENT_SECRET": "${AZURE_CLIENT_SECRET}",
        "AZURE_TENANT_ID": "${AZURE_TENANT_ID}"
      },
      "disabled": true
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-docker"
      ],
      "env": {}
    },
    "kubernetes": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-kubernetes"
      ],
      "env": {
        "KUBECONFIG": "${HOME}/.kube/config"
      },
      "disabled": true
    },
    "smithery-cli": {
      "command": "npx",
      "args": [
        "-y",
        "@smithery/cli-mcp"
      ],
      "env": {
        "SMITHERY_API_KEY": "${SMITHERY_API_KEY}"
      },
      "disabled": true
    },
    "smithery-stdout": {
      "command": "npx",
      "args": [
        "-y",
        "@smithery/stdout-mcp-server"
      ],
      "env": {},
      "disabled": true
    },
    "codex": {
      "command": "codex",
      "args": [
        "mcp"
      ],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      },
      "disabled": true
    },
    "xcodebuild": {
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp"
      ],
      "env": {},
      "description": "Xcode project management, simulator control, and iOS app utilities",
      "disabled": true
    },
    "enhanced-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "enhanced-postgres-mcp-server",
        "postgresql://localhost/dbname"
      ],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      },
      "description": "Enhanced PostgreSQL server with read and write capabilities",
      "disabled": true
    },
    "mcp-inspector": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/inspector"
      ],
      "env": {},
      "description": "MCP debugging and inspection tool",
      "disabled": true
    },
    "mcp-toolkit": {
      "command": "npx",
      "args": [
        "-y",
        "@magneticwatermelon/mcp-toolkit"
      ],
      "env": {},
      "description": "Build and ship MCP servers with zero-config",
      "disabled": true
    },
    "mcp-sdk": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/sdk"
      ],
      "env": {},
      "description": "Official MCP SDK for TypeScript - Build MCP clients and servers",
      "disabled": true
    },
    "ref-tools": {
      "command": "npx",
      "args": [
        "-y",
        "ref-tools-mcp"
      ],
      "env": {},
      "description": "Reference tools for code navigation and documentation",
      "disabled": true
    },
    "puppeteer-hisma": {
      "command": "npx",
      "args": [
        "-y",
        "@hisma/server-puppeteer"
      ],
      "env": {},
      "description": "Improved Puppeteer MCP server (v0.6.5 fork) for advanced browser automation",
      "disabled": true
    },
    "mcp-use": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-use"
      ],
      "env": {},
      "description": "Opinionated MCP Framework - Build MCP Agents, Clients, and Servers with MCP-UI support",
      "disabled": true
    }
  }
}
