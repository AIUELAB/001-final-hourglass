    def check_individual_fame_threshold(self, person_data: Dict) -> List[Dict]:
        """
        RULE_136: 個人知名度閾値チェック
        - 個人として独立した功績がない場合は削除
        - 知名度スコア < 5.0 の場合は削除候補
